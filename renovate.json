{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "group:monorepos",
    "group:recommended"
  ],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Keep Effect at rc.112 for the pinned @herdr/sdk Config.string and Config.mapOrFail APIs.",
      "matchFileNames": ["package.json"],
      "matchPackageNames": ["effect", "@effect/platform-node"],
      "allowedVersions": "4.0.0-rc.112"
    },
    {
      "description": "Group GitHub Actions.",
      "groupName": "github actions",
      "matchManagers": ["github-actions"]
    },
    {
      "description": "Keep Astro on the TypeScript programmatic API.",
      "matchDepNames": ["typescript"],
      "matchFileNames": ["capture/package.json"],
      "allowedVersions": "<7"
    }
  ]
}
