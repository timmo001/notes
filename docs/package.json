{
  "name": "notes-docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "blume dev",
    "start": "blume dev",
    "build": "blume build --strict",
    "check": "blume check --strict",
    "validate": "blume validate --strict",
    "deploy": "alchemy deploy --stage prod --yes",
    "deploy:github": "alchemy deploy --config stacks/github.ts --stage prod",
    "plan": "alchemy plan --stage prod",
    "preview": "blume preview",
    "brand": "bun scripts/brand-images.ts",
    "gen:cli": "bun scripts/generate-cli-reference.ts && bunx prettier --write src/content/docs/cli/commands.md",
    "gen:mcp": "bun scripts/generate-mcp-reference.ts && bunx prettier --write src/content/docs/mcp-server/tools.md",
    "gen": "bun run gen:cli && bun run gen:mcp"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@fontsource-variable/inter": "5.3.0",
    "@timmo001/docs-kit": "0.51.1",
    "blume": "2.2.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/github": "2.0.0-beta.87",
    "@effect/platform-bun": "4.1.5",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.5",
    "wrangler": "4.167.0"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ]
}
