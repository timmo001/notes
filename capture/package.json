{
  "name": "notes-capture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler types --config wrangler.example.jsonc && vite dev --configLoader runner",
    "build": "vite build --configLoader runner",
    "deploy": "alchemy deploy --stage prod --yes",
    "plan": "alchemy plan --stage prod",
    "preview": "vite preview --configLoader runner",
    "format": "prettier --write \"{src,tests}/**/*.{ts,css}\" \"index.html\" \"alchemy.run.ts\" \"vite.config.ts\" \"pwa.config.ts\" \"package.json\" \"tsconfig.json\" \"wrangler.example.jsonc\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,css}\" \"index.html\" \"alchemy.run.ts\" \"vite.config.ts\" \"pwa.config.ts\" \"package.json\" \"tsconfig.json\" \"wrangler.example.jsonc\"",
    "test": "bun test",
    "sync": "wrangler types --config wrangler.example.jsonc",
    "typecheck": "bun run sync && bun run typecheck:tsc",
    "typecheck:tsc": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "prepare": "effect-tsgo patch --force=false"
  },
  "dependencies": {
    "@timmo001/groundwork-pwa": "0.51.0",
    "@timmo001/groundwork-tokens": "0.51.0",
    "@timmo001/groundwork-ui": "0.51.0",
    "effect": "4.1.4",
    "jose": "^6.2.12",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@cloudflare/vite-plugin": "^1.62.2",
    "@effect/platform-bun": "4.1.4",
    "@effect/tsgo": "0.70.0",
    "@types/bun": "^1.4.2",
    "alchemy": "2.0.0-beta.87",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.144.0"
  },
  "trustedDependencies": [
    "@effect/tsgo"
  ]
}
