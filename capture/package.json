{
  "name": "notes-capture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler types --config wrangler.example.jsonc && vite dev",
    "build": "CAPTURE_WRANGLER_CONFIG=wrangler.deploy.jsonc vite build",
    "deploy": "CAPTURE_WRANGLER_CONFIG=wrangler.local.jsonc vite build && wrangler deploy",
    "deploy:preview": "CAPTURE_WRANGLER_CONFIG=wrangler.local.jsonc vite build && wrangler versions upload",
    "preview": "vite preview",
    "format": "prettier --write \"{src,tests}/**/*.{ts,css}\" \"index.html\" \"vite.config.ts\" \"package.json\" \"tsconfig.json\" \"wrangler.{deploy,example}.jsonc\" \"wrangler.jsonc\" \"public/**/*.{js,json,webmanifest}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,css}\" \"index.html\" \"vite.config.ts\" \"package.json\" \"tsconfig.json\" \"wrangler.{deploy,example}.jsonc\" \"wrangler.jsonc\" \"public/**/*.{js,json,webmanifest}\"",
    "test": "bun test",
    "sync": "wrangler types --config wrangler.example.jsonc",
    "typecheck": "bun run sync && tsc --noEmit",
    "prepare": "effect-tsgo patch --force=false"
  },
  "dependencies": {
    "effect": "4.0.1",
    "jose": "^6.2.12",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.2",
    "@effect/tsgo": "^0.51.0",
    "@types/bun": "^1.4.2",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.144.0"
  },
  "trustedDependencies": [
    "@effect/tsgo"
  ]
}
