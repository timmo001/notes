{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "notes-daemon",
  "share": "disabled",
  "update": "disable",
  "snapshots": false,
  "formatter": false,
  "lsp": false,
  "instructions": [],
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/x/all/readonly",
        "oauth": false,
        "codemode": false,
        "headers": {
          "Authorization": "Bearer {env:DOT_GH_MCP_BEARER}"
        }
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "oauth": false,
        "codemode": false
      },
      "notes": {
        "type": "local",
        "command": ["notes", "mcp"],
        "codemode": false
      }
    },
    "timeout": {
      "catalog": 30000,
      "execution": 30000
    }
  },
  "permissions": [{ "action": "*", "resource": "*", "effect": "deny" }]
}
