{
  "name": "notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "notes": "./dist/notes",
    "note": "./dist/notes",
    "handoffs": "./dist/notes",
    "handoff": "./dist/notes"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/notes",
    "test": "bun test",
    "lint": "oxlint .",
    "format": "prettier --write \"{src,tests}/**/*.ts\" \"docs/astro.config.mjs\" \"docs/scripts/**/*.{ts,mjs}\" \"docs/src/**/*.{md,mdx,astro,css}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\" \"docs/astro.config.mjs\" \"docs/scripts/**/*.{ts,mjs}\" \"docs/src/**/*.{md,mdx,astro,css}\"",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@herdr/sdk": "github:dmmulroy/herdr-ts-sdk#77abbf81ac35407bc5138a8f4fe19f0833af4402",
    "@opentui/core": "^0.5.0",
    "@timmo001/effect-gh": "github:timmo001/effect-gh#386d822dda0c8e73b66cf70782a7a332cbee7789",
    "@tuiparts/core": "^0.0.6",
    "effect": "4.0.0-rc.112",
    "fuse.js": "^7.5.0",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.45.0",
    "@oxlint/plugins": "1.82.0",
    "@timmo001/oxlint-rules": "0.3.0",
    "@types/bun": "^1.3.14",
    "@types/proper-lockfile": "^4.1.4",
    "oxlint": "1.82.0",
    "prettier": "^3.9.5",
    "typescript": "^7.0.0"
  },
  "overrides": {
    "effect": "$effect",
    "@effect/platform-node-shared": "$@effect/platform-node"
  },
  "patchedDependencies": {
    "@herdr/sdk@github:dmmulroy/herdr-ts-sdk#77abbf8": "patches/@herdr%2Fsdk@github%3Admmulroy%2Fherdr-ts-sdk#77abbf8.patch"
  },
  "trustedDependencies": [
    "@effect/tsgo"
  ]
}
