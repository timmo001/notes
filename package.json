{
  "name": "notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "notes": "./dist/notes",
    "note": "./dist/notes",
    "handoffs": "./dist/notes",
    "handoff": "./dist/notes"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/notes",
    "test": "bun test",
    "lint": "oxlint .",
    "format": "prettier --write \"{src,tests}/**/*.ts\" \"oxlint.config.ts\" \"{package,tsconfig}.json\" \"docs/{package,tsconfig}.json\" \"docs/astro.config.mjs\" \"docs/scripts/**/*.{ts,mjs}\" \"docs/src/**/*.{ts,md,mdx,astro,css}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\" \"oxlint.config.ts\" \"{package,tsconfig}.json\" \"docs/{package,tsconfig}.json\" \"docs/astro.config.mjs\" \"docs/scripts/**/*.{ts,mjs}\" \"docs/src/**/*.{ts,md,mdx,astro,css}\"",
    "prepare": "effect-tsgo patch --force=false"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.7",
    "@opentui/core": "^0.6.0",
    "@timmo001/effect-gh": "0.7.1",
    "@timmo001/effect-herdr": "0.9.0-timmo001.4",
    "@tuiparts/core": "^0.0.6",
    "effect": "4.0.7",
    "fuse.js": "^7.5.0",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.62.0",
    "@oxlint/plugins": "1.89.0",
    "@timmo001/oxlint-rules": "0.6.3",
    "@types/bun": "^1.4.2",
    "@types/proper-lockfile": "^4.1.4",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "effect": "$effect",
    "@effect/platform-node-shared": "$@effect/platform-node"
  },
  "trustedDependencies": [
    "@effect/tsgo"
  ]
}
