{
  "name": "@timmo001/effect-notes",
  "version": "0.1.0",
  "description": "Effect services for repository-scoped Markdown notes, the library behind the notes CLI, TUI and MCP server",
  "keywords": [
    "effect",
    "notes",
    "markdown",
    "git"
  ],
  "homepage": "https://github.com/timmo001/notes/tree/main/packages/effect-notes#readme",
  "bugs": {
    "url": "https://github.com/timmo001/notes/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmo001/notes.git",
    "directory": "packages/effect-notes"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "fuse.js": "7.5.0",
    "proper-lockfile": "4.1.2",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@effect/platform-node": "^4.0.1",
    "effect": "^4.0.1"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.7",
    "@types/node": "26.6.5",
    "@types/proper-lockfile": "4.1.4",
    "effect": "4.0.7"
  }
}
